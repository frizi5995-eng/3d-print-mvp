# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# /admin access: sign-in uses Supabase Auth (Email/Password). Only signed-in
# users whose email appears here (comma-separated, case-insensitive) may
# access /admin. Server-only — never expose this as NEXT_PUBLIC_.
ADMIN_EMAILS=

# Optional: when set, "Prepare quote" emails the customer their quote link
# automatically (via Resend). Leave blank to skip sending — the admin can
# still use "Copy quote link" regardless. Requires a Vercel Node.js runtime
# >=22.12 (resend's engine requirement) once enabled.
RESEND_API_KEY=
# Optional: sender address for quote emails, e.g. "Fabrik <quotes@yourdomain.com>".
# Must be a domain verified in Resend. Leave blank to use Resend's shared
# onboarding@resend.dev sandbox sender (works without domain verification,
# fine for early testing).
EMAIL_FROM_ADDRESS=

# This app's own public origin. Used to build absolute URLs (e.g. quote links
# in future emails) that work the same locally and once deployed.
# Local:      http://localhost:3000
# Production: the deployed Vercel/custom domain URL (set this in Vercel once known)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Cloudflare Turnstile (bot protection on the quote request form).
# Leave both blank to leave it disabled — the form and server action work
# normally either way; only server-side verification changes based on
# whether TURNSTILE_SECRET_KEY is set. Get keys from the Cloudflare
# dashboard -> Turnstile -> add a site (widget mode: Managed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Stripe invoicing/payments. Leave both blank to leave payments
# disabled — the rest of the product (quote/accept/decline, admin ops) keeps
# working normally, and /admin/settings shows Stripe as "Not configured".
# Test mode: get these from https://dashboard.stripe.com/test/apikeys
# Server-only. Never expose either as NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create at
# https://dashboard.stripe.com/test/webhooks (signing secret, starts "whsec_").
STRIPE_WEBHOOK_SECRET=

# Optional: Sculpteo supplier API (scaffolding — quoting/upload calls are
# not implemented yet, pending verified current API docs). Leave blank;
# rest of the app is unaffected. Server-only, never NEXT_PUBLIC_.
SCULPTEO_CLIENT_ID=
SCULPTEO_CLIENT_SECRET=
