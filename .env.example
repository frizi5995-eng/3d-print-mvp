# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Simple admin login for /admin (no user table for MVP).
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# Optional: enables transactional email once wired up. Leave blank to skip sending.
RESEND_API_KEY=
