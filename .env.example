# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# /admin access: sign-in uses Supabase Auth (Email/Password). Only signed-in
# users whose email appears here (comma-separated, case-insensitive) may
# access /admin. Server-only — never expose this as NEXT_PUBLIC_.
ADMIN_EMAILS=

# Optional: enables transactional email once wired up. Leave blank to skip sending.
RESEND_API_KEY=

# This app's own public origin. Used to build absolute URLs (e.g. quote links
# in future emails) that work the same locally and once deployed.
# Local:      http://localhost:3000
# Production: the deployed Vercel/custom domain URL (set this in Vercel once known)
NEXT_PUBLIC_APP_URL=http://localhost:3000
